{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker's name on Cloudflare: changing it here alone would deploy a new,
  // empty Worker. Rename the Worker on Cloudflare first (its custom domains
  // follow), then here. Deployed by .github/workflows/deploy.yml; brig.id and
  // www.brig.id are custom domains attached to it.
  "name": "brigid-site",
  // Only the custom domains serve the site.
  "workers_dev": false,
  "preview_urls": false,
  // Worker Previews (`wrangler preview`, run for each pull request by
  // .github/workflows/preview.yml) are served at <name>.brig.id: the brig.id
  // custom domain is enabled for Production and Preview in the dashboard.
  // They take no setting from production; the site needs none.
  "previews": {},
  "compatibility_date": "2026-11-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Every request goes through worker/index.ts: it adds the security
    // headers, redirects www to the apex and answers /api/status. Without
    // this, Cloudflare would serve matched files directly, without headers.
    "run_worker_first": true,
    // Unknown paths get dist/404.html with a 404 status.
    "not_found_handling": "404-page",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
    },
  },
}
