{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker's name on Cloudflare: renaming it here would deploy a new one.
  // Deployed by .github/workflows/deploy.yml; brig.id and www.brig.id are
  // custom domains attached to it.
  "name": "site",
  // Only the custom domains serve the site.
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-09-07",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Without this, Cloudflare serves matched static assets directly and
    // never invokes worker/index.ts — silently skipping the security
    // headers it adds. Routes every request through the Worker instead.
    "run_worker_first": true,
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
    },
  },
}
