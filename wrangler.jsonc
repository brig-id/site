{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Matches the Worker name Cloudflare created when the repo was connected
  // via Workers Builds — must stay in sync with the dashboard, not renamed
  // independently here.
  "name": "site",
  "compatibility_date": "2026-09-07",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Without this, Cloudflare serves matched static assets directly and
    // never invokes worker/index.ts — silently skipping the security
    // headers it adds. Routes every request through the Worker instead.
    "run_worker_first": true,
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
    },
  },
}
