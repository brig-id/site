---
import { iconBody } from "~/lib/icons";

interface Props {
  /** Phosphor name, e.g. "fingerprint" or "key-duotone". */
  name: string;
  class?: string;
  /** Accessible name. Without it the icon is decorative. */
  label?: string;
}

const { name, class: className, label } = Astro.props;
const body = iconBody(name);
---

<svg
  class:list={["icon", className]}
  viewBox="0 0 256 256"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  set:html={body}
/>
