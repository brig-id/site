---
// The brig·id mark: a white disc, the private self, and three cones of
// colour that leave it, one per identity, cut by the edge of the picture.
// The three have the same width, and the outer two mirror each other.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class:list={["mark", className]}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
>
  <circle cx="9.4" cy="16" r="7.9" fill="#fff3df"></circle>
  <path
    d="M19.17 10.13a11.4 11.4 0 0 1 1.24 2.92L33 9.68V1.82Z"
    fill="#ffb65c"
    stroke="#ffb65c"
    stroke-width="1.1"
    stroke-linejoin="round"
  ></path>
  <path
    d="M20.69 14.41a11.4 11.4 0 0 1 0 3.18L33 19.32v-6.64Z"
    fill="#ff86c8"
    stroke="#ff86c8"
    stroke-width="1.1"
    stroke-linejoin="round"
  ></path>
  <path
    d="M20.41 18.95a11.4 11.4 0 0 1-1.24 2.92L33 30.18v-7.86Z"
    fill="#5ad7f0"
    stroke="#5ad7f0"
    stroke-width="1.1"
    stroke-linejoin="round"
  ></path>
</svg>
