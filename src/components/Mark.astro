---
// The brig·id mark: one disc, cut in two. The left half is white, the private
// self; the right half is three colours fanned from the middle, one per
// identity. It is the scene of the home page, gathered into a circle.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class:list={["mark", className]}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
>
  <path d="M15.15 2.53a13.5 13.5 0 0 0 0 26.94Z" fill="#fff3df"></path>
  <path
    d="M16.85 2.53a13.5 13.5 0 0 1 10.46 6.09l-10.46 2.05Z"
    fill="#ffb65c"
  ></path>
  <path
    d="M16.85 12.4l11.33-2.21a13.5 13.5 0 0 1 0 11.62L16.85 19.6Z"
    fill="#ff86c8"
  ></path>
  <path
    d="M16.85 21.33l10.46 2.05a13.5 13.5 0 0 1-10.46 6.09Z"
    fill="#5ad7f0"
  ></path>
</svg>
