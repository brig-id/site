---
// The brig·id mark: a white disc, the private self, and the contact lens it
// wears, an arc of three colours, one per identity. It is the scene of the
// home page seen from the side, at the size of a letter.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class:list={["mark", className]}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
>
  <circle cx="12.4" cy="16" r="9.1" fill="#fff3df"></circle>
  <path
    d="M20.83 5.2a13.7 13.7 0 0 1 3.99 5.01"
    stroke="#ffb65c"
    stroke-width="3.3"
    stroke-linecap="round"
  ></path>
  <path
    d="M25.87 13.5a13.7 13.7 0 0 1 0 5"
    stroke="#ff86c8"
    stroke-width="3.3"
    stroke-linecap="round"
  ></path>
  <path
    d="M24.82 21.79a13.7 13.7 0 0 1-3.99 5.01"
    stroke="#5ad7f0"
    stroke-width="3.3"
    stroke-linecap="round"
  ></path>
</svg>
