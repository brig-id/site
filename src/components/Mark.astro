---
// The brig·id mark: one white point, the private self, and the identities
// that leave it, each in its own colour.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class:list={["mark", className]}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
>
  <path
    d="M10 16 25 7"
    stroke="#ffb65c"
    stroke-width="2.4"
    stroke-linecap="round"
  ></path>
  <path
    d="M10 16h16.5"
    stroke="#ff86c8"
    stroke-width="2.4"
    stroke-linecap="round"
  ></path>
  <path
    d="m10 16 15 9"
    stroke="#5ad7f0"
    stroke-width="2.4"
    stroke-linecap="round"
  ></path>
  <circle cx="9" cy="16" r="4.6" fill="#05060a"></circle>
  <circle cx="9" cy="16" r="3.4" fill="#fff3df"></circle>
</svg>
