---
// The picture of the whole idea: the private self is white light, the server
// is a lens, and every identity is one colour that leaves it. A colour does
// not tell you what the white light was.
import Icon from "./Icon.astro";
import { IDENTITIES } from "~/data/identities";

// The lens is seen from the side: two arcs of one circle, drawn on a box of
// 176 by 80 units. The stylesheet below places the rays from these numbers,
// so change them together.
const box = { width: 176, height: 80 };
const middle = box.width / 2;
const half = 76; // from the middle to a tip
const bulge = 33; // from the tips up to the top face, and down to the bottom
const top = 6;
const waist = top + bulge;
const bottom = waist + bulge;
const radius = (half * half + bulge * bulge) / (2 * bulge);
const round = (value: number) => Math.round(value * 10) / 10;
const arc = round(radius);

/** How low the bottom face is, `dx` units from the middle. */
const face = (dx: number) =>
  round(bottom - radius + Math.sqrt(radius * radius - dx * dx));

const glass =
  `M${middle - half} ${waist}A${arc} ${arc} 0 0 1 ${middle + half} ${waist}` +
  `A${arc} ${arc} 0 0 1 ${middle - half} ${waist}Z`;

// One ray per identity. Each leaves the bottom face from its own point
// (`dx` units from the middle) and lands on the middle of a card. The outer
// rays leave the glass more aslant than the inner ones (`lean`).
const ray = (
  hue: string,
  tint: string,
  color: string,
  dx: number,
  lean: number,
) => ({
  hue,
  tint,
  color,
  x: middle + dx,
  y: face(dx),
  path:
    dx < 0
      ? `M100 0C${100 - lean} 30 0 38 0 100`
      : `M0 0C${lean} 30 100 38 100 100`,
});

const rays = [
  ray("amber", "#ffe2b8", "#ffb65c", -46, 9),
  ray("rose", "#ffd0ea", "#ff86c8", -16, 3),
  ray("cyan", "#c6f1fa", "#5ad7f0", 16, 3),
  ray("violet", "#ddd2ff", "#a78bff", 46, 9),
] as const;

// Where the white light splits, inside the glass.
const split = { x: middle, y: top + 13 };
const first = rays[0];
const last = rays[3];
---

<div class="scene">
  <div class="self">
    <p class="cap cap-left">Your private self</p>
    <span class="orb">
      <Icon name="fingerprint" />
    </span>
    <p class="cap cap-right">No name, no password. Seen by no one.</p>
  </div>

  <span class="beam" aria-hidden="true"></span>

  <div class="lens">
    <svg viewBox={`0 0 ${box.width} ${box.height}`} aria-hidden="true">
      <defs>
        <linearGradient id="lens-glass" x1="0" y1="0" x2="0.9" y2="1">
          <stop offset="0" stop-color="#ffffff" stop-opacity="0.34"></stop>
          <stop offset="0.45" stop-color="#ffffff" stop-opacity="0.06"></stop>
          <stop offset="1" stop-color="#a78bff" stop-opacity="0.2"></stop>
        </linearGradient>
        <linearGradient id="lens-edge" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#ffffff" stop-opacity="0.95"></stop>
          <stop offset="1" stop-color="#ffffff" stop-opacity="0.25"></stop>
        </linearGradient>
        <radialGradient id="lens-sheen">
          <stop offset="0" stop-color="#ffffff" stop-opacity="0.42"></stop>
          <stop offset="1" stop-color="#ffffff" stop-opacity="0"></stop>
        </radialGradient>
        <clipPath id="lens-clip">
          <path d={glass}></path>
        </clipPath>
        <linearGradient
          id="lens-wedge"
          x1={first.x}
          y1="0"
          x2={last.x}
          y2="0"
          gradientUnits="userSpaceOnUse"
        >
          {rays.map((ray, index) => (
            <stop offset={index / 3} stop-color={ray.color} />
          ))}
        </linearGradient>
        <linearGradient
          id="lens-fade"
          x1="0"
          y1={split.y}
          x2="0"
          y2={bottom}
          gradientUnits="userSpaceOnUse"
        >
          <stop offset="0" stop-color="#fff" stop-opacity="0"></stop>
          <stop offset="1" stop-color="#fff" stop-opacity="1"></stop>
        </linearGradient>
        <mask id="lens-wedge-mask">
          <rect
            x="0"
            y="0"
            width={box.width}
            height={box.height}
            fill="url(#lens-fade)"
          ></rect>
        </mask>
        {rays.map((ray) => (
          <linearGradient
            id={`lens-ray-${ray.hue}`}
            x1={split.x}
            y1={split.y}
            x2={ray.x}
            y2={ray.y}
            gradientUnits="userSpaceOnUse"
          >
            <stop offset="0" stop-color="#ffffff" />
            <stop offset="0.55" stop-color={ray.tint} />
            <stop offset="1" stop-color={ray.color} />
          </linearGradient>
        ))}
        <radialGradient id="lens-spark">
          <stop offset="0" stop-color="#ffffff" stop-opacity="0.95"></stop>
          <stop offset="1" stop-color="#ffffff" stop-opacity="0"></stop>
        </radialGradient>
      </defs>

      <!-- The glass, the echo of its bottom face, and a sheen on the top. -->
      <path
        d={glass}
        fill="url(#lens-glass)"
        stroke="url(#lens-edge)"
        stroke-width="1.5"
        stroke-linejoin="round"
      ></path>
      <g clip-path="url(#lens-clip)">
        <path
          d={glass}
          transform="translate(0 5.5)"
          stroke="#ffffff"
          stroke-opacity="0.16"
        ></path>
        <ellipse
          cx={middle - 26}
          cy={waist - 15}
          rx="34"
          ry="7"
          fill="url(#lens-sheen)"
          transform={`rotate(-14 ${middle - 26} ${waist - 15})`}
        ></ellipse>
      </g>

      <!-- White light comes in, and splits. -->
      <path
        d={`M${middle} ${top}V${split.y}`}
        stroke="#ffffff"
        stroke-width="2"
        stroke-linecap="round"
      ></path>
      <path
        d={`M${split.x} ${split.y}L${first.x} ${first.y}A${arc} ${arc} 0 0 0 ${last.x} ${last.y}Z`}
        fill="url(#lens-wedge)"
        opacity="0.32"
        mask="url(#lens-wedge-mask)"
      ></path>
      {rays.map((ray) => (
        <path
          d={`M${split.x} ${split.y}L${ray.x} ${ray.y}`}
          stroke={`url(#lens-ray-${ray.hue})`}
          stroke-width="1.8"
          stroke-linecap="round"
        />
      ))}

      <!-- Where each colour leaves the glass. -->
      {rays.map((ray) => (
        <>
          <circle
            cx={ray.x}
            cy={ray.y}
            r="4.2"
            fill={ray.color}
            opacity="0.28"
          />
          <circle cx={ray.x} cy={ray.y} r="1.5" fill={ray.tint} />
        </>
      ))}
      <circle
        cx={middle}
        cy={top}
        r="4"
        fill="url(#lens-spark)"
        opacity="0.8"
      ></circle>
      <circle
        cx={split.x}
        cy={split.y}
        r="7.5"
        fill="url(#lens-spark)"
      ></circle>
    </svg>
    <p class="cap cap-right">Your brig·id server</p>
  </div>

  <div class="rays" aria-hidden="true">
    {rays.map((ray, index) => (
      <span class:list={["ray", `ray-${index + 1}`]}>
        <svg viewBox="0 0 100 100" preserveAspectRatio="none">
          <defs>
            <linearGradient
              id={`ray-${ray.hue}`}
              x1="0"
              y1="0"
              x2="0"
              y2="100"
              gradientUnits="userSpaceOnUse"
            >
              <stop offset="0" stop-color={ray.color} />
              <stop offset="1" stop-color={ray.color} />
            </linearGradient>
          </defs>
          <path class="glow" d={ray.path} stroke={`url(#ray-${ray.hue})`} />
          <path class="core" d={ray.path} stroke={`url(#ray-${ray.hue})`} />
          <path class="photon" d={ray.path} pathLength="100" />
        </svg>
      </span>
    ))}
  </div>

  <ul class="facets">
    {IDENTITIES.map((identity) => (
      <li class:list={["facet", "card", `hue-${identity.hue}`]}>
        <span class="facet-icon">
          <Icon name={identity.icon} />
        </span>
        <h3>{identity.name}</h3>
        <p>{identity.role}</p>
        <dl>
          <div>
            <dt>Seen by</dt>
            <dd>{identity.site}</dd>
          </div>
          <div>
            <dt>Known as</dt>
            <dd>{identity.sample}</dd>
          </div>
        </dl>
      </li>
    ))}
  </ul>

  <p class="moral">
    <Icon name="lock-key-duotone" />
    Each site meets one identity. None of them can follow the light back.
  </p>
</div>

<style>
  .scene {
    --lens: 12.5rem;
    display: grid;
    justify-items: center;
    width: min(100%, 66rem);
    margin-inline: auto;
  }

  /* -- The private self ---------------------------------------------------- */

  .self,
  .lens {
    position: relative;
    display: grid;
    place-items: center;
  }

  .orb {
    position: relative;
    display: grid;
    place-items: center;
    width: 4.75rem;
    height: 4.75rem;
    border-radius: 50%;
    background: radial-gradient(
      circle at 35% 30%,
      #fff,
      var(--self) 55%,
      #f3c98f
    );
    color: #2a1d0a;
    font-size: 2.2rem;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.7) inset,
      0 0 1.5rem rgb(255 243 223 / 0.75),
      0 0 5rem rgb(255 200 130 / 0.55),
      0 0 11rem rgb(255 182 92 / 0.35);
  }

  .orb::before,
  .orb::after {
    content: "";
    position: absolute;
    inset: -0.9rem;
    border: 1px solid rgb(255 243 223 / 0.35);
    border-radius: 50%;
    animation: ring 4s var(--ease) infinite;
  }

  .orb::after {
    animation-delay: 2s;
  }

  @keyframes ring {
    0% {
      transform: scale(0.82);
      opacity: 0.9;
    }
    100% {
      transform: scale(1.75);
      opacity: 0;
    }
  }

  .cap {
    position: absolute;
    top: 50%;
    width: max-content;
    max-width: min(15rem, 32vw);
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    line-height: 1.45;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .cap-left {
    right: calc(100% + 1.6rem);
    text-align: right;
    color: var(--self);
  }

  .cap-right {
    left: calc(100% + 1.6rem);
  }

  .beam {
    width: 2px;
    height: 3.25rem;
    margin-top: 0.35rem;
    background: linear-gradient(180deg, #fff, var(--self));
    box-shadow:
      0 0 0.6rem 1px rgb(255 243 223 / 0.9),
      0 0 2.2rem 0.3rem rgb(255 200 130 / 0.5);
  }

  /* -- The lens ------------------------------------------------------------- */

  /* The top face sits 6 units below the top of the box, 176 units wide: the
     beam ends on the glass. */
  .lens svg {
    display: block;
    width: var(--lens);
    margin-top: calc(var(--lens) * -6 / 176);
    overflow: visible;
    fill: none;
    filter: drop-shadow(0 0 1.6rem rgb(255 255 255 / 0.28));
  }

  /* Beside the tip of the glass. */
  .lens .cap-right {
    left: calc(100% + 1.1rem);
    top: 44%;
  }

  /* -- The colours ---------------------------------------------------------- */

  /* Each ray is a box stretched between two points: where it leaves the lens
     (a fixed distance from the middle, since the lens does not follow the
     width of the page) and the middle of its card (a share of the width). */
  .rays {
    /* The exits are 46 and 16 units from the middle of the lens, which is
       176 units wide. The bottom face curves, so the outer ones leave it
       18.7 units above the bottom of its box, the inner ones 9.2. */
    --out: calc(var(--lens) * 46 / 176);
    --in: calc(var(--lens) * 16 / 176);
    --out-lift: calc(var(--lens) * -18.7 / 176);
    --in-lift: calc(var(--lens) * -9.2 / 176);
    --gap: 1rem; /* the gap of the cards below */
    position: relative;
    justify-self: stretch;
    height: 8.5rem;
  }

  .ray {
    position: absolute;
    bottom: 0;
  }

  .ray-1 {
    top: var(--out-lift);
    left: calc(12.5% - 0.375 * var(--gap));
    right: calc(50% + var(--out));
  }

  .ray-2 {
    top: var(--in-lift);
    left: calc(37.5% - 0.125 * var(--gap));
    right: calc(50% + var(--in));
  }

  .ray-3 {
    top: var(--in-lift);
    left: calc(50% + var(--in));
    right: calc(37.5% - 0.125 * var(--gap));
  }

  .ray-4 {
    top: var(--out-lift);
    left: calc(50% + var(--out));
    right: calc(12.5% - 0.375 * var(--gap));
  }

  .ray svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
  }

  .ray path {
    vector-effect: non-scaling-stroke;
    stroke-linecap: round;
  }

  .glow {
    stroke-width: 9;
    opacity: 0.3;
    filter: blur(7px);
  }

  .core {
    stroke-width: 1.5;
    opacity: 0.95;
  }

  .photon {
    stroke: #fff;
    stroke-width: 2.4;
    stroke-dasharray: 5 95;
    stroke-dashoffset: 100;
    animation: travel 3.6s linear infinite;
    filter: drop-shadow(0 0 5px #fff);
  }

  .ray-2 .photon {
    animation-delay: -0.9s;
  }

  .ray-3 .photon {
    animation-delay: -1.8s;
  }

  .ray-4 .photon {
    animation-delay: -2.7s;
  }

  @keyframes travel {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* -- The identities ------------------------------------------------------- */

  .facets {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    width: 100%;
  }

  .facet {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.4rem 1.25rem 1.2rem;
    overflow: visible;
    text-align: left;
    box-shadow: 0 -1.5rem 3.5rem -2rem var(--hue);
  }

  /* Where the ray lands. */
  .facet::after {
    content: "";
    position: absolute;
    top: -1px;
    left: 50%;
    width: 44%;
    height: 2px;
    transform: translateX(-50%);
    border-radius: 2px;
    background: linear-gradient(90deg, transparent, var(--hue), transparent);
    box-shadow: 0 0 1.2rem 1px var(--hue);
  }

  .facet-icon {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    margin-bottom: 0.3rem;
    border: 1px solid color-mix(in srgb, var(--hue) 40%, transparent);
    border-radius: 0.8rem;
    background: color-mix(in srgb, var(--hue) 14%, transparent);
    color: var(--hue);
    font-size: 1.4rem;
  }

  .facet h3 {
    font-size: 1.12rem;
    letter-spacing: -0.02em;
  }

  .facet p {
    margin-bottom: 0.55rem;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--text-2);
  }

  .facet dl {
    display: grid;
    gap: 0.3rem;
    margin: auto 0 0;
    padding-top: 0.8rem;
    border-top: 1px dashed var(--line-2);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .facet dl div {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .facet dt {
    color: var(--text-3);
  }

  .facet dd {
    margin: 0;
    color: var(--hue);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .moral {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 2rem;
    font-size: 0.95rem;
    color: var(--text-2);
    text-align: left;
  }

  .moral :global(.icon) {
    font-size: 1.25rem;
    color: var(--self);
  }

  @media (max-width: 52rem) {
    .scene {
      --lens: 9.5rem;
    }

    /* Two columns, filled one after the other: the two left rays feed the
       left column, the two right rays the right one, without crossing. */
    .facets {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(2, auto);
      grid-auto-flow: column;
      gap: 0.75rem;
    }

    .facet:nth-child(even) {
      box-shadow: none;
    }

    .facet:nth-child(even)::after {
      display: none;
    }

    .rays {
      --gap: 0.75rem;
      --spread: 0.55rem;
      height: 6rem;
    }

    .ray-1 {
      left: calc(25% - 0.25 * var(--gap) - var(--spread));
    }

    .ray-2 {
      left: calc(25% - 0.25 * var(--gap) + var(--spread));
    }

    .ray-3 {
      right: calc(25% - 0.25 * var(--gap) + var(--spread));
    }

    .ray-4 {
      right: calc(25% - 0.25 * var(--gap) - var(--spread));
    }

    /* What is left between the orb and the edge of the page. */
    .cap {
      max-width: calc(50vw - 3.5rem - var(--gutter));
      font-size: 0.64rem;
    }

    .cap-left {
      right: calc(100% + 1.1rem);
    }

    .cap-right {
      left: calc(100% + 1.1rem);
    }

    .lens .cap-right {
      left: calc(100% + 0.6rem);
      max-width: calc(50vw - var(--lens) / 2 - 0.6rem - var(--gutter));
    }
  }

  @media (max-width: 26rem) {
    .facet {
      padding: 1.1rem 0.9rem 1rem;
    }

    .facet dl div {
      flex-direction: column;
      gap: 0;
    }
  }
</style>
