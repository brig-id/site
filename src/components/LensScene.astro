---
// The picture of the whole idea: the private self is white light, the server
// is a lens worn by the self, and every identity is one colour that leaves it.
// The lens is a band bent around the self: its hollow side shelters the self,
// its rounded side sends the colours out. A colour does not tell you what the
// white light was.
//
// The band is drawn with two hairlines, like the rings that leave the self,
// and almost nothing between them: a fence one can see the light through. Its
// two ends fade out instead of stopping.
import Icon from "./Icon.astro";
import { IDENTITIES } from "~/data/identities";

// Ten units to the rem, on a box of 120 by 40.5 units. The band turns around
// the middle of the orb, which is 14 units above the box. The stylesheet
// below places the rays from these numbers, so change them together.
const box = { width: 120, height: 40.5 };
const centre = { x: box.width / 2, y: -14 };
const hollow = 37; // from the middle of the orb to the near hairline
const rounded = 48.5; // and to the far one
const half = 62; // how far the band reaches each way, in degrees from straight down
const turn = Math.PI / 180;
const round = (value: number) => Math.round(value * 10) / 10;

/** The point `r` units from the middle of the orb, `deg` from straight down. */
const at = (r: number, deg: number) => ({
  x: round(centre.x + r * Math.sin(deg * turn)),
  y: round(centre.y + r * Math.cos(deg * turn)),
});
const spot = (r: number, deg: number) => `${at(r, deg).x} ${at(r, deg).y}`;

/** A stretch of the circle of radius `r`, from left to right. */
const arc = (r: number, from: number, to: number) =>
  `M${spot(r, from)}A${r} ${r} 0 0 0 ${spot(r, to)}`;

const near = arc(hollow, -half, half);
const far = arc(rounded, -half, half);
// What lies between the two hairlines.
const glass =
  `${far}L${spot(hollow, half)}` +
  `A${hollow} ${hollow} 0 0 1 ${spot(hollow, -half)}Z`;
// The ends fade over the first and the last fifth of the width of the band.
const ends = { left: at(rounded, -half).x, right: at(rounded, half).x };

// One ray per identity, `deg` from straight down. White light crosses from
// the self to the near hairline; the colour is born on the far one, from a
// short lit stretch, and goes on to the middle of a card. The outer rays
// leave more aslant than the inner ones (`lean`).
const ray = (
  hue: string,
  tint: string,
  color: string,
  deg: number,
  lean: number,
) => ({
  hue,
  tint,
  color,
  from: at(27, deg),
  enter: at(hollow, deg),
  inside: at((hollow + rounded) / 2 + 1.5, deg),
  leave: at(rounded, deg),
  port: arc(rounded, deg - 7.5, deg + 7.5),
  path:
    deg < 0
      ? `M100 0C${100 - lean} 30 0 38 0 100`
      : `M0 0C${lean} 30 100 38 100 100`,
});

const rays = [
  ray("amber", "#ffe2b8", "#ffb65c", -45, 13),
  ray("rose", "#ffd0ea", "#ff86c8", -15, 11),
  ray("cyan", "#c6f1fa", "#5ad7f0", 15, 11),
  ray("violet", "#ddd2ff", "#a78bff", 45, 13),
] as const;
---

<div class="scene">
  <div class="self">
    <p class="cap cap-self">
      <span class="cap-name">Your private self</span>
      <span>No name, no password.</span>
      <span>Seen by no one.</span>
    </p>
    <span class="orb">
      <Icon name="fingerprint" />
    </span>
  </div>

  <div class="lens">
    <svg viewBox={`0 0 ${box.width} ${box.height}`} aria-hidden="true">
      <defs>
        <filter id="lens-soft" x="-80%" y="-80%" width="260%" height="260%">
          <feGaussianBlur stdDeviation="3.2"></feGaussianBlur>
        </filter>
        <linearGradient
          id="lens-glass"
          x1="0"
          y1={centre.y + hollow}
          x2="0"
          y2={centre.y + rounded}
          gradientUnits="userSpaceOnUse"
        >
          <stop offset="0" stop-color="#fff3df" stop-opacity="0.24"></stop>
          <stop offset="1" stop-color="#ffffff" stop-opacity="0.05"></stop>
        </linearGradient>
        <linearGradient
          id="lens-fade"
          x1={ends.left}
          y1="0"
          x2={ends.right}
          y2="0"
          gradientUnits="userSpaceOnUse"
        >
          <stop offset="0" stop-color="#fff" stop-opacity="0"></stop>
          <stop offset="0.2" stop-color="#fff" stop-opacity="1"></stop>
          <stop offset="0.8" stop-color="#fff" stop-opacity="1"></stop>
          <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
        </linearGradient>
        <mask id="lens-ends">
          <rect
            x="0"
            y="-10"
            width={box.width}
            height="60"
            fill="url(#lens-fade)"
          ></rect>
        </mask>
        {rays.map((r) => (
          <linearGradient
            id={`lens-white-${r.hue}`}
            x1={r.from.x}
            y1={r.from.y}
            x2={r.enter.x}
            y2={r.enter.y}
            gradientUnits="userSpaceOnUse"
          >
            <stop offset="0" stop-color="#ffffff" stop-opacity="0" />
            <stop offset="1" stop-color="#ffffff" stop-opacity="0.95" />
          </linearGradient>
        ))}
      </defs>

      <!-- Two hairlines and a breath of glass between them. -->
      <g mask="url(#lens-ends)">
        <path d={glass} fill="url(#lens-glass)"></path>
        <path d={near} stroke="#fff3df" stroke-opacity="0.75"></path>
        <path d={far} stroke="#ffffff" stroke-opacity="0.42"></path>
      </g>

      <!-- White light comes in; inside, a hint of the colour to come. -->
      {rays.map((r) => (
        <>
          <circle
            cx={r.inside.x}
            cy={r.inside.y}
            r="5.5"
            fill={r.color}
            opacity="0.32"
            filter="url(#lens-soft)"
          />
          <path
            d={`M${r.from.x} ${r.from.y}L${r.enter.x} ${r.enter.y}`}
            stroke={`url(#lens-white-${r.hue})`}
            stroke-width="1.5"
            stroke-linecap="round"
          />
          <circle cx={r.enter.x} cy={r.enter.y} r="1.2" fill="#ffffff" />
        </>
      ))}

      <!-- Where each colour leaves: a lit stretch of the far hairline. -->
      {rays.map((r) => (
        <>
          <path
            d={r.port}
            stroke={r.color}
            stroke-width="5"
            stroke-linecap="round"
            opacity="0.75"
            filter="url(#lens-soft)"
          />
          <path
            d={r.port}
            stroke={r.color}
            stroke-width="1.5"
            stroke-linecap="round"
          />
          <circle cx={r.leave.x} cy={r.leave.y} r="1.3" fill={r.tint} />
        </>
      ))}
    </svg>
    <p class="cap cap-lens">
      <span class="cap-name">Your brig·id server</span>
      <span>Keeps your identities apart.</span>
    </p>
  </div>

  <div class="rays" aria-hidden="true">
    {rays.map((r, index) => (
      <span class:list={["ray", `ray-${index + 1}`]}>
        <svg viewBox="0 0 100 100" preserveAspectRatio="none">
          <path class="glow" d={r.path} stroke={r.color} />
          <path class="core" d={r.path} stroke={r.color} />
          <path class="photon" d={r.path} pathLength="100" />
        </svg>
      </span>
    ))}
  </div>

  <ul class="facets">
    {IDENTITIES.map((identity) => (
      <li class:list={["facet", "card", `hue-${identity.hue}`]}>
        <span class="facet-icon">
          <Icon name={identity.icon} />
        </span>
        <h3>{identity.name}</h3>
        <p>{identity.role}</p>
        <dl>
          <div>
            <dt>Seen by</dt>
            <dd>{identity.site}</dd>
          </div>
          <div>
            <dt>Known as</dt>
            <dd>{identity.sample}</dd>
          </div>
        </dl>
      </li>
    ))}
  </ul>

  <p class="moral">
    <Icon name="lock-key-duotone" />
    Each site meets one identity. None of them can follow the light back.
  </p>
</div>

<style>
  .scene {
    --lens: 12rem;
    --gap: 1rem; /* the gap of the cards */
    display: grid;
    justify-items: center;
    width: min(100%, 66rem);
    margin-inline: auto;
  }

  /* -- The private self ---------------------------------------------------- */

  .self,
  .lens {
    position: relative;
    display: grid;
    place-items: center;
  }

  .orb {
    position: relative;
    display: grid;
    place-items: center;
    width: 4.75rem;
    height: 4.75rem;
    border-radius: 50%;
    background: radial-gradient(
      circle at 35% 30%,
      #fff,
      var(--self) 55%,
      #f3c98f
    );
    color: #2a1d0a;
    font-size: 2.2rem;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.7) inset,
      0 0 1.5rem rgb(255 243 223 / 0.75),
      0 0 5rem rgb(255 200 130 / 0.55),
      0 0 11rem rgb(255 182 92 / 0.35);
  }

  .orb::before,
  .orb::after {
    content: "";
    position: absolute;
    inset: -0.9rem;
    border: 1px solid rgb(255 243 223 / 0.35);
    border-radius: 50%;
    animation: ring 4s var(--ease) infinite;
  }

  .orb::after {
    animation-delay: 2s;
  }

  @keyframes ring {
    0% {
      transform: scale(0.82);
      opacity: 0.9;
    }
    100% {
      transform: scale(1.75);
      opacity: 0;
    }
  }

  /* Two captions, one on each side: a name, then what there is to know. */
  .cap {
    position: absolute;
    top: 50%;
    width: max-content;
    max-width: min(17rem, 32vw);
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    line-height: 1.5;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .cap span {
    display: block;
  }

  .cap-self {
    right: calc(100% + 1.6rem);
    text-align: right;
  }

  .cap-self .cap-name {
    color: var(--self);
  }

  .cap-lens .cap-name {
    color: var(--text);
  }

  /* -- The lens ------------------------------------------------------------- */

  /* The orb is 4.75rem tall and the drawing starts 1.4rem below its middle,
     so that the band turns around the self. Its size follows the orb, not the
     width of the page. */
  .lens svg {
    display: block;
    width: var(--lens);
    margin-top: -0.975rem;
    overflow: visible;
    fill: none;
  }

  /* Beside the right end of the band, lower than the caption of the self:
     the eye goes from one to the other the way the light does. */
  .cap-lens {
    top: -0.85rem;
    left: calc(100% - 1rem);
    text-align: left;
  }

  /* -- The colours ---------------------------------------------------------- */

  /* Each ray is a box stretched between two points: where it leaves the lens
     (a fixed distance from the middle, since the lens does not follow the
     width of the page) and the middle of its card (a share of the width).
     The exits are 34.3 and 12.6 units from the middle of the lens, which is
     120 units wide. The band curves, so the outer ones leave it 20.2 units
     before the end of its box, the inner ones 7.7. */
  .rays {
    --out: calc(var(--lens) * 34.3 / 120);
    --in: calc(var(--lens) * 12.6 / 120);
    --out-lift: calc(var(--lens) * -20.2 / 120);
    --in-lift: calc(var(--lens) * -7.7 / 120);
    position: relative;
    justify-self: stretch;
    height: 8.5rem;
  }

  .ray {
    position: absolute;
    bottom: 0;
  }

  .ray-1 {
    top: var(--out-lift);
    left: calc(12.5% - 0.375 * var(--gap));
    right: calc(50% + var(--out));
  }

  .ray-2 {
    top: var(--in-lift);
    left: calc(37.5% - 0.125 * var(--gap));
    right: calc(50% + var(--in));
  }

  .ray-3 {
    top: var(--in-lift);
    left: calc(50% + var(--in));
    right: calc(37.5% - 0.125 * var(--gap));
  }

  .ray-4 {
    top: var(--out-lift);
    left: calc(50% + var(--out));
    right: calc(12.5% - 0.375 * var(--gap));
  }

  .ray svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
  }

  .ray path {
    vector-effect: non-scaling-stroke;
    stroke-linecap: round;
  }

  .glow {
    stroke-width: 9;
    opacity: 0.3;
    filter: blur(7px);
  }

  .core {
    stroke-width: 1.5;
    opacity: 0.95;
  }

  .photon {
    stroke: #fff;
    stroke-width: 2.4;
    stroke-dasharray: 5 95;
    stroke-dashoffset: 100;
    animation: travel 3.6s linear infinite;
    filter: drop-shadow(0 0 5px #fff);
  }

  .ray-2 .photon {
    animation-delay: -0.9s;
  }

  .ray-3 .photon {
    animation-delay: -1.8s;
  }

  .ray-4 .photon {
    animation-delay: -2.7s;
  }

  @keyframes travel {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* -- The identities ------------------------------------------------------- */

  .facets {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap);
    width: 100%;
  }

  .facet {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.4rem 1.25rem 1.2rem;
    overflow: visible;
    text-align: left;
    box-shadow: 0 -1.5rem 3.5rem -2rem var(--hue);
  }

  /* Where the ray lands. */
  .facet::after {
    content: "";
    position: absolute;
    top: -1px;
    left: 50%;
    width: 44%;
    height: 2px;
    transform: translateX(-50%);
    border-radius: 2px;
    background: linear-gradient(90deg, transparent, var(--hue), transparent);
    box-shadow: 0 0 1.2rem 1px var(--hue);
  }

  .facet-icon {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    margin-bottom: 0.3rem;
    border: 1px solid color-mix(in srgb, var(--hue) 40%, transparent);
    border-radius: 0.8rem;
    background: color-mix(in srgb, var(--hue) 14%, transparent);
    color: var(--hue);
    font-size: 1.4rem;
  }

  .facet h3 {
    font-size: 1.12rem;
    letter-spacing: -0.02em;
  }

  .facet p {
    margin-bottom: 0.55rem;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--text-2);
  }

  .facet dl {
    display: grid;
    gap: 0.3rem;
    margin: auto 0 0;
    padding-top: 0.8rem;
    border-top: 1px dashed var(--line-2);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .facet dl div {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .facet dt {
    color: var(--text-3);
  }

  .facet dd {
    margin: 0;
    color: var(--hue);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .moral {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 2rem;
    font-size: 0.95rem;
    color: var(--text-2);
    text-align: left;
  }

  .moral :global(.icon) {
    font-size: 1.25rem;
    color: var(--self);
  }

  /* -- Narrow --------------------------------------------------------------- */

  @media (max-width: 52rem) {
    .scene {
      --gap: 0.75rem;
    }

    /* Two columns, filled one after the other: the two left rays feed the
       left column, the two right rays the right one, without crossing. */
    .facets {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(2, auto);
      grid-auto-flow: column;
    }

    .facet:nth-child(even) {
      box-shadow: none;
    }

    .facet:nth-child(even)::after {
      display: none;
    }

    .rays {
      --spread: 0.55rem;
      height: 6rem;
    }

    .ray-1 {
      left: calc(25% - 0.25 * var(--gap) - var(--spread));
    }

    .ray-2 {
      left: calc(25% - 0.25 * var(--gap) + var(--spread));
    }

    .ray-3 {
      right: calc(25% - 0.25 * var(--gap) + var(--spread));
    }

    .ray-4 {
      right: calc(25% - 0.25 * var(--gap) - var(--spread));
    }

    /* What is left between the orb, or the lens, and the edge of the page. */
    .cap {
      max-width: calc(50vw - 3.5rem - var(--gutter));
      font-size: 0.64rem;
    }

    .cap-self {
      right: calc(100% + 1.1rem);
    }

    /* Beside the orb as well, on the other side: there is no room lower. */
    .cap-lens {
      top: -2.375rem;
      left: calc(50% + 3.475rem);
    }
  }

  @media (max-width: 26rem) {
    .facet {
      padding: 1.1rem 0.9rem 1rem;
    }

    .facet dl div {
      flex-direction: column;
      gap: 0;
    }
  }
</style>
