---
// The picture of the whole idea: the private self is white light, the server
// is a prism, and every identity is one colour that leaves it. A colour does
// not tell you what the white light was.
import Icon from "./Icon.astro";
import { IDENTITIES } from "~/data/identities";

const wide = [
  { d: "M500 0C500 96 125 64 125 200", hue: "amber" },
  { d: "M500 0C500 84 375 96 375 200", hue: "rose" },
  { d: "M500 0C500 84 625 96 625 200", hue: "cyan" },
  { d: "M500 0C500 96 875 64 875 200", hue: "violet" },
];
const narrow = [
  { d: "M500 0C500 96 250 70 250 200", hue: "amber" },
  { d: "M500 0C500 96 750 70 750 200", hue: "rose" },
];
const stops: Record<string, string> = {
  amber: "#ffb65c",
  rose: "#ff86c8",
  cyan: "#5ad7f0",
  violet: "#a78bff",
};
---

<div class="scene">
  <div class="self">
    <p class="cap cap-left">Your private self</p>
    <span class="orb">
      <Icon name="fingerprint" />
    </span>
    <p class="cap cap-right">One passkey. Shown to no one.</p>
  </div>

  <span class="beam" aria-hidden="true"></span>

  <div class="prism">
    <svg viewBox="0 0 120 104" aria-hidden="true">
      <defs>
        <linearGradient id="prism-glass" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#ffffff" stop-opacity="0.34"></stop>
          <stop offset="0.5" stop-color="#ffffff" stop-opacity="0.06"></stop>
          <stop offset="1" stop-color="#a78bff" stop-opacity="0.22"></stop>
        </linearGradient>
        <linearGradient id="prism-edge" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#ffffff" stop-opacity="0.95"></stop>
          <stop offset="1" stop-color="#ffffff" stop-opacity="0.25"></stop>
        </linearGradient>
      </defs>
      <path
        d="M60 6 114 98H6Z"
        fill="url(#prism-glass)"
        stroke="url(#prism-edge)"
        stroke-width="1.5"
        stroke-linejoin="round"
      ></path>
      <path
        d="M60 6 60 98"
        stroke="#ffffff"
        stroke-opacity="0.5"
        stroke-width="1"
      ></path>
      <path
        d="M60 6 34 98"
        stroke="#ffffff"
        stroke-opacity="0.12"
        stroke-width="1"
      ></path>
      <path
        d="M60 6 86 98"
        stroke="#ffffff"
        stroke-opacity="0.12"
        stroke-width="1"
      ></path>
    </svg>
    <p class="cap cap-right">Your brig·id server</p>
  </div>

  {[
    { rays: wide, name: "rays-wide" },
    { rays: narrow, name: "rays-narrow" },
  ].map(({ rays, name }) => (
    <svg
      class:list={["rays", name]}
      viewBox="0 0 1000 200"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <defs>
        {rays.map((ray) => (
          <linearGradient
            id={`${name}-${ray.hue}`}
            gradientUnits="userSpaceOnUse"
            x1="0"
            y1="0"
            x2="0"
            y2="200"
          >
            <stop offset="0" stop-color="#fff3df" />
            <stop offset="0.45" stop-color={stops[ray.hue]} />
            <stop offset="1" stop-color={stops[ray.hue]} />
          </linearGradient>
        ))}
      </defs>
      {rays.map((ray) => (
        <g>
          <path class="glow" d={ray.d} stroke={`url(#${name}-${ray.hue})`} />
          <path class="core" d={ray.d} stroke={`url(#${name}-${ray.hue})`} />
          <path
            class:list={["photon", `photon-${ray.hue}`]}
            d={ray.d}
            pathLength="100"
          />
        </g>
      ))}
    </svg>
  ))}

  <ul class="facets">
    {IDENTITIES.map((identity) => (
      <li class:list={["facet", "card", `hue-${identity.hue}`]}>
        <span class="facet-icon">
          <Icon name={identity.icon} />
        </span>
        <h3>{identity.name}</h3>
        <p>{identity.role}</p>
        <dl>
          <div>
            <dt>Seen by</dt>
            <dd>{identity.site}</dd>
          </div>
          <div>
            <dt>Known as</dt>
            <dd>{identity.sample}</dd>
          </div>
        </dl>
      </li>
    ))}
  </ul>

  <p class="moral">
    <Icon name="lock-key-duotone" />
    Each site meets one identity. None of them can follow the light back.
  </p>
</div>

<style>
  .scene {
    display: grid;
    justify-items: center;
    width: min(100%, 66rem);
    margin-inline: auto;
  }

  /* -- The private self ---------------------------------------------------- */

  .self,
  .prism {
    position: relative;
    display: grid;
    place-items: center;
  }

  .orb {
    position: relative;
    display: grid;
    place-items: center;
    width: 4.75rem;
    height: 4.75rem;
    border-radius: 50%;
    background: radial-gradient(
      circle at 35% 30%,
      #fff,
      var(--self) 55%,
      #f3c98f
    );
    color: #2a1d0a;
    font-size: 2.2rem;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.7) inset,
      0 0 1.5rem rgb(255 243 223 / 0.75),
      0 0 5rem rgb(255 200 130 / 0.55),
      0 0 11rem rgb(255 182 92 / 0.35);
  }

  .orb::before,
  .orb::after {
    content: "";
    position: absolute;
    inset: -0.9rem;
    border: 1px solid rgb(255 243 223 / 0.35);
    border-radius: 50%;
    animation: ring 4s var(--ease) infinite;
  }

  .orb::after {
    animation-delay: 2s;
  }

  @keyframes ring {
    0% {
      transform: scale(0.82);
      opacity: 0.9;
    }
    100% {
      transform: scale(1.75);
      opacity: 0;
    }
  }

  .cap {
    position: absolute;
    top: 50%;
    width: max-content;
    max-width: min(15rem, 32vw);
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    line-height: 1.45;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .cap-left {
    right: calc(100% + 1.6rem);
    text-align: right;
    color: var(--self);
  }

  .cap-right {
    left: calc(100% + 1.6rem);
  }

  .beam {
    width: 2px;
    height: 3.25rem;
    margin-top: 0.35rem;
    background: linear-gradient(180deg, #fff, var(--self));
    box-shadow:
      0 0 0.6rem 1px rgb(255 243 223 / 0.9),
      0 0 2.2rem 0.3rem rgb(255 200 130 / 0.5);
  }

  /* -- The prism ------------------------------------------------------------ */

  .prism svg {
    width: 6.5rem;
    margin-top: -0.3rem;
    filter: drop-shadow(0 0 1.6rem rgb(255 255 255 / 0.28));
  }

  .prism .cap-right {
    left: calc(100% + 0.9rem);
    top: 62%;
  }

  /* -- The colours ---------------------------------------------------------- */

  .rays {
    width: 100%;
    height: 8.5rem;
    margin-top: -0.55rem;
    overflow: visible;
    fill: none;
  }

  .rays-narrow {
    display: none;
  }

  .rays path {
    vector-effect: non-scaling-stroke;
    stroke-linecap: round;
  }

  .glow {
    stroke-width: 9;
    opacity: 0.28;
    filter: blur(7px);
  }

  .core {
    stroke-width: 1.4;
    opacity: 0.9;
  }

  .photon {
    stroke: #fff;
    stroke-width: 2.4;
    stroke-dasharray: 5 95;
    stroke-dashoffset: 100;
    animation: travel 3.6s linear infinite;
    filter: drop-shadow(0 0 5px #fff);
  }

  .photon-rose {
    animation-delay: -0.9s;
  }

  .photon-cyan {
    animation-delay: -1.8s;
  }

  .photon-violet {
    animation-delay: -2.7s;
  }

  @keyframes travel {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* -- The identities ------------------------------------------------------- */

  .facets {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    width: 100%;
  }

  .facet {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.4rem 1.25rem 1.2rem;
    overflow: visible;
    text-align: left;
    box-shadow: 0 -1.5rem 3.5rem -2rem var(--hue);
  }

  /* Where the ray lands. */
  .facet::after {
    content: "";
    position: absolute;
    top: -1px;
    left: 50%;
    width: 44%;
    height: 2px;
    transform: translateX(-50%);
    border-radius: 2px;
    background: linear-gradient(90deg, transparent, var(--hue), transparent);
    box-shadow: 0 0 1.2rem 1px var(--hue);
  }

  .facet-icon {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    margin-bottom: 0.3rem;
    border: 1px solid color-mix(in srgb, var(--hue) 40%, transparent);
    border-radius: 0.8rem;
    background: color-mix(in srgb, var(--hue) 14%, transparent);
    color: var(--hue);
    font-size: 1.4rem;
  }

  .facet h3 {
    font-size: 1.12rem;
    letter-spacing: -0.02em;
  }

  .facet p {
    margin-bottom: 0.55rem;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--text-2);
  }

  .facet dl {
    display: grid;
    gap: 0.3rem;
    margin: auto 0 0;
    padding-top: 0.8rem;
    border-top: 1px dashed var(--line-2);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .facet dl div {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .facet dt {
    color: var(--text-3);
  }

  .facet dd {
    margin: 0;
    color: var(--hue);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .moral {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 2rem;
    font-size: 0.95rem;
    color: var(--text-2);
    text-align: left;
  }

  .moral :global(.icon) {
    font-size: 1.25rem;
    color: var(--self);
  }

  @media (max-width: 52rem) {
    .facets {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }

    .rays-wide {
      display: none;
    }

    .rays-narrow {
      display: block;
      height: 6rem;
    }

    .cap {
      font-size: 0.64rem;
    }

    .cap-left {
      right: calc(100% + 1.1rem);
    }

    .cap-right {
      left: calc(100% + 1.1rem);
    }
  }

  @media (max-width: 26rem) {
    .facet {
      padding: 1.1rem 0.9rem 1rem;
    }

    .facet dl div {
      flex-direction: column;
      gap: 0;
    }
  }
</style>
