---
// The picture of the whole idea: the private self is white light, the server
// is a prism, and every identity is one colour that leaves it. A colour does
// not tell you what the white light was.
import Icon from "./Icon.astro";
import { IDENTITIES } from "~/data/identities";

// One ray per identity. Each leaves the prism from its own point on the base
// (`exit`, in the prism's own units) and lands on the middle of a card. The
// stylesheet places both ends, so the picture holds at any width.
const rays = [
  { hue: "amber", tint: "#ffe2b8", color: "#ffb65c", exit: 26, side: "left" },
  { hue: "rose", tint: "#ffd0ea", color: "#ff86c8", exit: 48, side: "left" },
  { hue: "cyan", tint: "#c6f1fa", color: "#5ad7f0", exit: 72, side: "right" },
  { hue: "violet", tint: "#ddd2ff", color: "#a78bff", exit: 94, side: "right" },
] as const;

// Where the white light splits, inside the prism.
const split = { x: 60, y: 34 };
const base = 98;
const path = {
  left: "M100 0C100 50 0 38 0 100",
  right: "M0 0C0 50 100 38 100 100",
};
---

<div class="scene">
  <div class="self">
    <p class="cap cap-left">Your private self</p>
    <span class="orb">
      <Icon name="fingerprint" />
    </span>
    <p class="cap cap-right">No name, no password. Seen by no one.</p>
  </div>

  <span class="beam" aria-hidden="true"></span>

  <div class="prism">
    <svg viewBox="0 0 120 104" aria-hidden="true">
      <defs>
        <linearGradient id="prism-glass" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#ffffff" stop-opacity="0.3"></stop>
          <stop offset="0.5" stop-color="#ffffff" stop-opacity="0.05"></stop>
          <stop offset="1" stop-color="#a78bff" stop-opacity="0.18"></stop>
        </linearGradient>
        <linearGradient id="prism-edge" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#ffffff" stop-opacity="0.95"></stop>
          <stop offset="1" stop-color="#ffffff" stop-opacity="0.25"></stop>
        </linearGradient>
        <linearGradient
          id="prism-wedge"
          x1={rays[0].exit}
          y1="0"
          x2={rays[3].exit}
          y2="0"
          gradientUnits="userSpaceOnUse"
        >
          {rays.map((ray, index) => (
            <stop offset={index / 3} stop-color={ray.color} />
          ))}
        </linearGradient>
        <linearGradient
          id="prism-fade"
          x1="0"
          y1={split.y}
          x2="0"
          y2={base}
          gradientUnits="userSpaceOnUse"
        >
          <stop offset="0" stop-color="#fff" stop-opacity="0"></stop>
          <stop offset="1" stop-color="#fff" stop-opacity="1"></stop>
        </linearGradient>
        <mask id="prism-wedge-mask">
          <rect
            x="0"
            y="0"
            width="120"
            height="104"
            fill="url(#prism-fade)"
          ></rect>
        </mask>
        {rays.map((ray) => (
          <linearGradient
            id={`prism-ray-${ray.hue}`}
            x1={split.x}
            y1={split.y}
            x2={ray.exit}
            y2={base}
            gradientUnits="userSpaceOnUse"
          >
            <stop offset="0" stop-color="#ffffff" />
            <stop offset="0.55" stop-color={ray.tint} />
            <stop offset="1" stop-color={ray.color} />
          </linearGradient>
        ))}
        <radialGradient id="prism-spark">
          <stop offset="0" stop-color="#ffffff" stop-opacity="0.95"></stop>
          <stop offset="1" stop-color="#ffffff" stop-opacity="0"></stop>
        </radialGradient>
      </defs>

      <!-- The glass. -->
      <path
        d="M60 6 114 98H6Z"
        fill="url(#prism-glass)"
        stroke="url(#prism-edge)"
        stroke-width="1.5"
        stroke-linejoin="round"
      ></path>

      <!-- White light comes in, and splits. -->
      <path
        d={`M60 6V${split.y}`}
        stroke="#ffffff"
        stroke-width="2"
        stroke-linecap="round"
      ></path>
      <path
        d={`M${split.x} ${split.y}L${rays[0].exit} ${base}H${rays[3].exit}Z`}
        fill="url(#prism-wedge)"
        opacity="0.3"
        mask="url(#prism-wedge-mask)"
      ></path>
      {rays.map((ray) => (
        <path
          d={`M${split.x} ${split.y}L${ray.exit} ${base}`}
          stroke={`url(#prism-ray-${ray.hue})`}
          stroke-width="1.8"
          stroke-linecap="round"
        />
      ))}
      <circle cx={split.x} cy={split.y} r="7" fill="url(#prism-spark)"></circle>
    </svg>
    <p class="cap cap-right">Your brig·id server</p>
  </div>

  <div class="rays" aria-hidden="true">
    {rays.map((ray, index) => (
      <span class:list={["ray", `ray-${index + 1}`]}>
        <svg viewBox="0 0 100 100" preserveAspectRatio="none">
          <defs>
            <linearGradient
              id={`ray-${ray.hue}`}
              x1="0"
              y1="0"
              x2="0"
              y2="100"
              gradientUnits="userSpaceOnUse"
            >
              <stop offset="0" stop-color={ray.color} />
              <stop offset="1" stop-color={ray.color} />
            </linearGradient>
          </defs>
          <path
            class="glow"
            d={path[ray.side]}
            stroke={`url(#ray-${ray.hue})`}
          />
          <path
            class="core"
            d={path[ray.side]}
            stroke={`url(#ray-${ray.hue})`}
          />
          <path class="photon" d={path[ray.side]} pathLength="100" />
        </svg>
      </span>
    ))}
  </div>

  <ul class="facets">
    {IDENTITIES.map((identity) => (
      <li class:list={["facet", "card", `hue-${identity.hue}`]}>
        <span class="facet-icon">
          <Icon name={identity.icon} />
        </span>
        <h3>{identity.name}</h3>
        <p>{identity.role}</p>
        <dl>
          <div>
            <dt>Seen by</dt>
            <dd>{identity.site}</dd>
          </div>
          <div>
            <dt>Known as</dt>
            <dd>{identity.sample}</dd>
          </div>
        </dl>
      </li>
    ))}
  </ul>

  <p class="moral">
    <Icon name="lock-key-duotone" />
    Each site meets one identity. None of them can follow the light back.
  </p>
</div>

<style>
  .scene {
    --prism: 8rem;
    display: grid;
    justify-items: center;
    width: min(100%, 66rem);
    margin-inline: auto;
  }

  /* -- The private self ---------------------------------------------------- */

  .self,
  .prism {
    position: relative;
    display: grid;
    place-items: center;
  }

  .orb {
    position: relative;
    display: grid;
    place-items: center;
    width: 4.75rem;
    height: 4.75rem;
    border-radius: 50%;
    background: radial-gradient(
      circle at 35% 30%,
      #fff,
      var(--self) 55%,
      #f3c98f
    );
    color: #2a1d0a;
    font-size: 2.2rem;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.7) inset,
      0 0 1.5rem rgb(255 243 223 / 0.75),
      0 0 5rem rgb(255 200 130 / 0.55),
      0 0 11rem rgb(255 182 92 / 0.35);
  }

  .orb::before,
  .orb::after {
    content: "";
    position: absolute;
    inset: -0.9rem;
    border: 1px solid rgb(255 243 223 / 0.35);
    border-radius: 50%;
    animation: ring 4s var(--ease) infinite;
  }

  .orb::after {
    animation-delay: 2s;
  }

  @keyframes ring {
    0% {
      transform: scale(0.82);
      opacity: 0.9;
    }
    100% {
      transform: scale(1.75);
      opacity: 0;
    }
  }

  .cap {
    position: absolute;
    top: 50%;
    width: max-content;
    max-width: min(15rem, 32vw);
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    line-height: 1.45;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .cap-left {
    right: calc(100% + 1.6rem);
    text-align: right;
    color: var(--self);
  }

  .cap-right {
    left: calc(100% + 1.6rem);
  }

  .beam {
    width: 2px;
    height: 3.25rem;
    margin-top: 0.35rem;
    background: linear-gradient(180deg, #fff, var(--self));
    box-shadow:
      0 0 0.6rem 1px rgb(255 243 223 / 0.9),
      0 0 2.2rem 0.3rem rgb(255 200 130 / 0.5);
  }

  /* -- The prism ------------------------------------------------------------ */

  .prism svg {
    width: var(--prism);
    margin-top: -0.3rem;
    filter: drop-shadow(0 0 1.6rem rgb(255 255 255 / 0.28));
  }

  /* Beside the slope of the glass, not beside the box around it. */
  .prism .cap-right {
    left: calc(100% - 0.6rem);
    top: 62%;
  }

  /* -- The colours ---------------------------------------------------------- */

  /* Each ray is a box stretched between two points: where it leaves the prism
     (a fixed distance from the middle, since the prism does not scale) and
     the middle of its card (a share of the width). */
  .rays {
    /* The exits are 34 and 12 units from the middle of the prism, which is
       120 units wide; its base sits 6 units above the bottom of its box. */
    --out: calc(var(--prism) * 34 / 120);
    --in: calc(var(--prism) * 12 / 120);
    --gap: 1rem; /* the gap of the cards below */
    position: relative;
    justify-self: stretch;
    height: 8.5rem;
    margin-top: calc(var(--prism) * -6 / 120);
  }

  .ray {
    position: absolute;
    inset-block: 0;
  }

  .ray-1 {
    left: calc(12.5% - 0.375 * var(--gap));
    right: calc(50% + var(--out));
  }

  .ray-2 {
    left: calc(37.5% - 0.125 * var(--gap));
    right: calc(50% + var(--in));
  }

  .ray-3 {
    left: calc(50% + var(--in));
    right: calc(37.5% - 0.125 * var(--gap));
  }

  .ray-4 {
    left: calc(50% + var(--out));
    right: calc(12.5% - 0.375 * var(--gap));
  }

  .ray svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
  }

  .ray path {
    vector-effect: non-scaling-stroke;
    stroke-linecap: round;
  }

  .glow {
    stroke-width: 9;
    opacity: 0.3;
    filter: blur(7px);
  }

  .core {
    stroke-width: 1.5;
    opacity: 0.95;
  }

  .photon {
    stroke: #fff;
    stroke-width: 2.4;
    stroke-dasharray: 5 95;
    stroke-dashoffset: 100;
    animation: travel 3.6s linear infinite;
    filter: drop-shadow(0 0 5px #fff);
  }

  .ray-2 .photon {
    animation-delay: -0.9s;
  }

  .ray-3 .photon {
    animation-delay: -1.8s;
  }

  .ray-4 .photon {
    animation-delay: -2.7s;
  }

  @keyframes travel {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* -- The identities ------------------------------------------------------- */

  .facets {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    width: 100%;
  }

  .facet {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.4rem 1.25rem 1.2rem;
    overflow: visible;
    text-align: left;
    box-shadow: 0 -1.5rem 3.5rem -2rem var(--hue);
  }

  /* Where the ray lands. */
  .facet::after {
    content: "";
    position: absolute;
    top: -1px;
    left: 50%;
    width: 44%;
    height: 2px;
    transform: translateX(-50%);
    border-radius: 2px;
    background: linear-gradient(90deg, transparent, var(--hue), transparent);
    box-shadow: 0 0 1.2rem 1px var(--hue);
  }

  .facet-icon {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    margin-bottom: 0.3rem;
    border: 1px solid color-mix(in srgb, var(--hue) 40%, transparent);
    border-radius: 0.8rem;
    background: color-mix(in srgb, var(--hue) 14%, transparent);
    color: var(--hue);
    font-size: 1.4rem;
  }

  .facet h3 {
    font-size: 1.12rem;
    letter-spacing: -0.02em;
  }

  .facet p {
    margin-bottom: 0.55rem;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--text-2);
  }

  .facet dl {
    display: grid;
    gap: 0.3rem;
    margin: auto 0 0;
    padding-top: 0.8rem;
    border-top: 1px dashed var(--line-2);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .facet dl div {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .facet dt {
    color: var(--text-3);
  }

  .facet dd {
    margin: 0;
    color: var(--hue);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .moral {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 2rem;
    font-size: 0.95rem;
    color: var(--text-2);
    text-align: left;
  }

  .moral :global(.icon) {
    font-size: 1.25rem;
    color: var(--self);
  }

  @media (max-width: 52rem) {
    /* Two columns, filled one after the other: the two left rays feed the
       left column, the two right rays the right one, without crossing. */
    .facets {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(2, auto);
      grid-auto-flow: column;
      gap: 0.75rem;
    }

    .facet:nth-child(even) {
      box-shadow: none;
    }

    .facet:nth-child(even)::after {
      display: none;
    }

    .rays {
      --gap: 0.75rem;
      --spread: 0.55rem;
      height: 6rem;
    }

    .ray-1 {
      left: calc(25% - 0.25 * var(--gap) - var(--spread));
    }

    .ray-2 {
      left: calc(25% - 0.25 * var(--gap) + var(--spread));
    }

    .ray-3 {
      right: calc(25% - 0.25 * var(--gap) + var(--spread));
    }

    .ray-4 {
      right: calc(25% - 0.25 * var(--gap) - var(--spread));
    }

    /* What is left between the orb and the edge of the page. */
    .cap {
      max-width: calc(50vw - 3.5rem - var(--gutter));
      font-size: 0.64rem;
    }

    .cap-left {
      right: calc(100% + 1.1rem);
    }

    .cap-right {
      left: calc(100% + 1.1rem);
    }

    .prism .cap-right {
      left: calc(100% - 1rem);
      max-width: calc(50vw - 3.2rem - var(--gutter));
    }
  }

  @media (max-width: 26rem) {
    .facet {
      padding: 1.1rem 0.9rem 1rem;
    }

    .facet dl div {
      flex-direction: column;
      gap: 0;
    }
  }
</style>
