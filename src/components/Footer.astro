---
import Icon from "./Icon.astro";
import Mark from "./Mark.astro";
import { GITHUB, SPEC } from "~/data/nav";

const columns = [
  {
    title: "Understand",
    links: [
      { href: "/", label: "Overview" },
      { href: "/features/", label: "Features" },
      { href: "/identities/", label: "How identities work" },
    ],
  },
  {
    title: "Project",
    links: [
      { href: "/manifesto/", label: "Manifesto" },
      { href: "/history/", label: "History" },
      { href: "/status/", label: "Service status" },
      { href: "/servers/", label: "Server map" },
    ],
  },
  {
    title: "Source",
    links: [
      { href: GITHUB, label: "GitHub", external: true },
      { href: SPEC, label: "Specifications", external: true },
      {
        href: `${SPEC}/tree/main/decisions`,
        label: "Decisions",
        external: true,
      },
      {
        href: "https://github.com/brig-id/server-leaf/releases",
        label: "Releases",
        external: true,
      },
    ],
  },
];
---

<footer class="site-footer">
  <div class="shell top">
    <div class="about">
      <a class="brand" href="/" aria-label="brig·id, home">
        <Mark />
        <span class="wordmark">
          brig<span class="dot">·</span>id
        </span>
      </a>
      <p>
        One private self, many identities. A self-hosted, passkey-only identity
        server.
      </p>
      <p class="state">
        <span class="pill-dot"></span>
        Pre-beta. Not ready to be relied on.
      </p>
    </div>

    {columns.map((column) => (
      <nav aria-label={column.title}>
        <h2>{column.title}</h2>
        <ul>
          {column.links.map((link) => (
            <li>
              <a href={link.href}>
                {link.label}
                {"external" in link && <Icon name="arrow-up-right" />}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>

  <div class="shell bottom">
    <p>
      Open source under the
      <a href="https://github.com/brig-id/site/blob/main/LICENSE">LGPL-3.0</a>.
    </p>
    <p>
      This site sets no cookie, runs no tracker and loads nothing from anyone
      else.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(1rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
    background: linear-gradient(
      180deg,
      rgb(255 255 255 / 0.025),
      transparent 14rem
    );
  }

  .top {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
    gap: 2.5rem;
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }

  .about {
    display: grid;
    align-content: start;
    gap: 1rem;
    max-width: 22rem;
    color: var(--text-2);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text);
    text-decoration: none;
  }

  .brand :global(.mark) {
    width: 2rem;
    height: 2rem;
  }

  .wordmark {
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .dot {
    margin-inline: 0.04em;
    color: var(--amber);
    text-shadow: 0 0 0.9rem var(--amber);
  }

  .state {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.88rem;
    color: var(--text-3);
  }

  h2 {
    margin-bottom: 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  nav ul {
    display: grid;
    gap: 0.6rem;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--text-2);
    text-decoration: none;
    transition: color 0.2s;
  }

  nav a:hover {
    color: var(--text);
  }

  nav a :global(.icon) {
    font-size: 0.85em;
    color: var(--text-3);
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.5rem 2.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.86rem;
    color: var(--text-3);
  }

  @media (max-width: 52rem) {
    .top {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .about {
      grid-column: 1 / -1;
    }
  }
</style>
