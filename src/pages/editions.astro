---
import Base from "~/layouts/Base.astro";
import Icon from "~/components/Icon.astro";
import StatusTag from "~/components/StatusTag.astro";
import { EDITIONS, EDITION_ROWS, SAME_EVERYWHERE } from "~/data/editions";
import { RELEASE, feature } from "~/data/features";
---

<Base
  title="leaf, grove, forest"
  description="The three editions of the brig·id server compared: leaf for one machine, grove for several, forest for companies. What exists today and what is planned."
>
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">Editions</p>
      <h1>
        leaf, grove, <span class="accent spectrum">forest.</span>
      </h1>
      <p class="lead">
        One server software in three sizes. Only the first exists today: leaf
        {RELEASE.version}. The other two are planned, and this page says what is
        decided about them and what is not.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <ol class="cards">
        {EDITIONS.map((edition) => (
          <li class="card edition hue-green rise" id={edition.id}>
            <span class="edition-icon">
              <Icon name={feature(edition.id).icon} />
            </span>
            <StatusTag status={feature(edition.id).status} />
            <h2>{edition.id}</h2>
            <p class="edition-line">{edition.line}</p>
            <p>{feature(edition.id).summary}</p>
            <p class="edition-price">
              <b>{edition.price}</b>
              <span>{edition.priceNote}</span>
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <header class="section-head rise">
        <p class="eyebrow">Side by side</p>
        <h2>
          What <span class="accent">changes</span> with size.
        </h2>
      </header>

      <div class="table-wrap card rise">
        <table>
          <thead>
            <tr>
              <td></td>
              {EDITIONS.map((edition) => (
                <th scope="col">
                  <span class="col-name">{edition.id}</span>
                  <StatusTag status={feature(edition.id).status} />
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {EDITION_ROWS.map((row) => (
              <tr>
                <th scope="row">
                  {row.label}
                  {row.why && <small>{row.why}</small>}
                </th>
                {row.cells.map((cell) => (
                  <td class:list={[{ tbd: cell === "To be defined" }]}>
                    {cell}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="aside rise">
        grove and forest are not written yet. Their rows describe the plan in
        the repositories; details will change as they are built.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <header class="section-head rise">
        <p class="eyebrow">What does not change</p>
        <h2>
          An identity is the same on <span class="accent">any</span> of them.
        </h2>
        <p class="lead">
          The editions differ in how they are run, not in what they protect.
        </p>
      </header>
      <ul class="same">
        {SAME_EVERYWHERE.map((item) => (
          <li class="card tile rise">
            <Icon name={item.icon} />
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="shell-narrow prose">
      <h2>Which one?</h2>
      <ul>
        <li>
          <strong>Start with a leaf.</strong> It is the one that exists, and one
          small machine is enough for a person, a family or an association.
        </li>
        <li>
          <strong>grove, when one machine is no longer enough</strong>: more
          people than it can serve, or a sign-in that must survive the loss of a
          server. Non-profits choose between leaf and grove by size alone.
        </li>
        <li>
          <strong>forest, when a company depends on it.</strong> It is the paid
          edition, and it will be built with the companies that need it.
        </li>
      </ul>
      <p>
        <a class="link-arrow" href="/pricing/">
          See the pricing
          <Icon name="arrow-right" />
        </a>
      </p>
    </div>
  </section>
</Base>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .edition {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.7rem;
    padding: clamp(1.4rem, 2.6vw, 2rem);
    scroll-margin-top: calc(var(--header-h) + 2rem);
  }

  .edition-icon {
    display: grid;
    place-items: center;
    width: 3.2rem;
    height: 3.2rem;
    margin-bottom: 0.6rem;
    border: 1px solid rgb(98 227 164 / 0.3);
    border-radius: 1rem;
    background: rgb(98 227 164 / 0.08);
    color: var(--green);
    font-size: 1.8rem;
  }

  .edition h2 {
    font-family: var(--font-mono);
    font-size: 1.7rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .edition-line {
    font-weight: 540;
  }

  .edition > p:not(.edition-line, .edition-price) {
    line-height: 1.55;
    color: var(--text-2);
  }

  .edition-price {
    display: grid;
    gap: 0.15rem;
    width: 100%;
    margin-top: auto;
    padding-top: 1.1rem;
    border-top: 1px dashed var(--line-2);
    font-size: 0.9rem;
    color: var(--text-2);
  }

  .edition-price b {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 2rem;
    line-height: 1.1;
    color: var(--text);
  }

  .table-wrap {
    overflow-x: auto;
  }

  table {
    width: 100%;
    min-width: 46rem;
    border-collapse: collapse;
  }

  th,
  td {
    width: 26%;
    padding: 1.05rem 1.2rem;
    text-align: left;
    vertical-align: top;
    line-height: 1.5;
  }

  thead th {
    font-weight: 500;
  }

  .col-name {
    display: block;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
    font-size: 1.25rem;
  }

  tbody tr {
    border-top: 1px solid var(--line);
  }

  tbody th {
    width: 22%;
    font-weight: 540;
  }

  tbody th small {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--text-3);
  }

  tbody td {
    color: var(--text-2);
  }

  tbody td:nth-child(2) {
    color: var(--text);
    background: color-mix(in srgb, var(--green) 4%, transparent);
  }

  .tbd {
    font-style: italic;
    color: var(--text-3);
  }

  .aside {
    margin-top: 1.25rem;
    font-size: 0.95rem;
    color: var(--text-3);
  }

  .same {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .tile {
    display: grid;
    align-content: start;
    gap: 0.7rem;
    padding: 1.5rem;
  }

  .tile > :global(.icon) {
    font-size: 1.8rem;
    color: var(--self);
  }

  .tile h3 {
    font-size: 1.1rem;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .tile p {
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--text-2);
  }

  @media (max-width: 60rem) {
    .cards {
      grid-template-columns: 1fr;
    }

    .same {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 34rem) {
    .same {
      grid-template-columns: 1fr;
    }
  }
</style>
