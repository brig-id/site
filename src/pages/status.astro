---
import Base from "~/layouts/Base.astro";
import Icon from "~/components/Icon.astro";
import { SERVICES } from "../../worker/status";

// The same list the Worker probes, so the page and /api/status cannot drift.
const services = [
  {
    id: "site",
    name: "brig.id",
    description: "This website, served from Cloudflare's edge.",
    checks: [{ id: "edge", label: "Website" }],
  },
  ...SERVICES.map((service) => ({
    id: service.id,
    name: service.name,
    description: service.description,
    checks: service.probes.map((probe) => ({
      id: probe.id,
      label: probe.label,
    })),
  })),
];
---

<Base
  title="Status"
  description="Live status of the services the brig·id project runs: this website and the helm.brig.id server."
>
  <section class="page-hero">
    <div class="shell-narrow">
      <p class="eyebrow">Status</p>
      <h1>
        Is it <span class="accent spectrum">up?</span>
      </h1>
      <p class="lead">
        The services the project runs itself, checked when you open this page.
        brig·id is self-hosted: servers run by other people are theirs to watch.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="shell-narrow board" data-status>
      <div class="overall card" data-overall data-state="pending">
        <span class="lamp"></span>
        <div>
          <p class="overall-text" data-overall-text role="status">
            Checking…
          </p>
          <p class="overall-sub" data-checked-at>
            Asking the servers how they are.
          </p>
        </div>
        <button class="btn btn-ghost" type="button" data-refresh>
          <Icon name="arrows-clockwise" />
          Check again
        </button>
      </div>

      <ul class="services">
        {services.map((service) => (
          <li
            class="card service"
            data-service={service.id}
            data-state="pending"
          >
            <header>
              <div>
                <h2>{service.name}</h2>
                <p>{service.description}</p>
              </div>
              <p class="badge">
                <span class="lamp" />
                <span data-service-label>Checking</span>
              </p>
            </header>
            <ul class="checks">
              {service.checks.map((check) => (
                <li data-check={check.id} data-state="pending">
                  <span class="lamp" />
                  <span class="check-name">{check.label}</span>
                  <span class="check-result" data-check-label>
                    …
                  </span>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>

      <noscript>
        <p class="note">
          <Icon name="warning-duotone" />
          <span>
            This page needs JavaScript to show live results. The raw report is
            at <a href="/api/status">/api/status</a>.
          </span>
        </p>
      </noscript>
    </div>
  </section>

  <section class="section">
    <div class="shell-narrow prose">
      <h2>What this page tells you</h2>
      <ul>
        <li>
          <strong>What is checked.</strong> For helm.brig.id: that the server
          answers its health endpoint, publishes its signing keys and serves its
          DID document. The checks run from Cloudflare's network, not from your
          browser, so the server never learns who is looking.
        </li>
        <li>
          <strong>What is not.</strong> There is no history and no incident log
          yet. A green light means “answering now”, nothing more.
        </li>
        <li>
          <strong>What helm.brig.id is.</strong> The project's own server, a
          single seedling. It is where each release is tried first: it can
          change or go offline without notice, and it is not a service to depend
          on.
        </li>
      </ul>
      <p>
        The report is also available as JSON at
        <a href="/api/status">
          <code>/api/status</code>
        </a>
        . Something looks wrong?
        <a href="https://github.com/brig-id/server-seedling/issues">
          Open an issue.
        </a>
      </p>
    </div>
  </section>

  <script>
    import "~/scripts/status";
  </script>
</Base>

<style>
  .board {
    display: grid;
    gap: 1rem;
  }

  .lamp {
    flex: none;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--lamp, var(--text-3));
    box-shadow: 0 0 0.9rem var(--lamp, transparent);
  }

  [data-state="pending"] > .lamp,
  [data-state="pending"] .badge .lamp {
    animation: wait 1.2s ease-in-out infinite;
  }

  @keyframes wait {
    50% {
      opacity: 0.25;
    }
  }

  [data-state="operational"],
  [data-state="up"] {
    --lamp: var(--green);
  }

  [data-state="degraded"] {
    --lamp: var(--amber);
  }

  [data-state="down"] {
    --lamp: var(--coral);
  }

  .overall {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.25rem;
    padding: clamp(1.4rem, 3vw, 2rem);
    background:
      radial-gradient(
        30rem 12rem at 0% 50%,
        color-mix(in srgb, var(--lamp, #fff) 14%, transparent),
        transparent 70%
      ),
      var(--bg-1);
  }

  .overall > .lamp {
    width: 1.1rem;
    height: 1.1rem;
    box-shadow:
      0 0 0 0.4rem color-mix(in srgb, var(--lamp, #fff) 18%, transparent),
      0 0 2rem var(--lamp, transparent);
  }

  .overall-text {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 560;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .overall-sub {
    margin-top: 0.3rem;
    font-size: 0.9rem;
    color: var(--text-3);
  }

  .overall .btn {
    padding: 0.6rem 1rem;
    font-size: 0.88rem;
  }

  .overall .btn[disabled] {
    opacity: 0.5;
    cursor: progress;
  }

  .services {
    display: grid;
    gap: 1rem;
  }

  .service {
    padding: clamp(1.3rem, 3vw, 1.9rem);
  }

  .service header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  .service h2 {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .service header p {
    max-width: 30rem;
    margin-top: 0.4rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--text-2);
  }

  .service header .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
    padding: 0.3rem 0.8rem 0.3rem 0.65rem;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text);
  }

  .badge .lamp {
    width: 0.5rem;
    height: 0.5rem;
  }

  .checks {
    margin-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .checks li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--line);
  }

  .checks li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .checks .lamp {
    width: 0.5rem;
    height: 0.5rem;
  }

  .check-result {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-2);
  }

  @media (max-width: 36rem) {
    .overall {
      grid-template-columns: auto 1fr;
    }

    .overall .btn {
      grid-column: 1 / -1;
    }
  }
</style>
