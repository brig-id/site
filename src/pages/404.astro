---
import Base from "~/layouts/Base.astro";
import Icon from "~/components/Icon.astro";
---

<Base
  title="Page not found"
  description="This page does not exist on brig.id."
  noindex
>
  <section class="lost">
    <div class="shell-narrow">
      <p class="code">404</p>
      <h1>
        Nobody by that <span class="accent spectrum">name.</span>
      </h1>
      <p class="lead">
        The page you asked for is not here. It may have moved, or it never
        existed.
      </p>
      <div class="row">
        <a class="btn btn-primary" href="/">
          <Icon name="house-line" />
          Home
        </a>
        <a class="btn btn-ghost" href="/identities/">
          How identities work
        </a>
        <a class="btn btn-ghost" href="/features/">
          Features
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .lost {
    display: grid;
    align-items: center;
    min-height: 78dvh;
    padding-top: calc(var(--header-h) + 4rem);
    padding-bottom: 4rem;
  }

  .lost .shell-narrow {
    display: grid;
    justify-items: start;
    gap: 1.4rem;
  }

  .code {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    color: var(--amber);
  }

  h1 {
    font-size: clamp(2.6rem, 8vw, 5rem);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
</style>
