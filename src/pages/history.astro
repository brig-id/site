---
import Base from "~/layouts/Base.astro";
import Icon from "~/components/Icon.astro";
import StatusTag from "~/components/StatusTag.astro";

const PAPER = "https://hal.science/hal-05193465v1";

const authors =
  "Fanny Georges, Antoine Seilles, Guillaume Artignan, Bérenger Arnaud, Mountaz Hascoët, Nancy Rodriguez, Birgitta Dresp-Langley, Jean Sallantin";

interface Entry {
  date: string;
  title: string;
  text: string[];
}

const question: Entry[] = [
  {
    date: "2008",
    title: "Can we do better than the keyboard?",
    text: [
      "Bérenger Arnaud begins research in human-computer interaction at the LIRMM, in Montpellier, with a plain question: can people do better than type? That includes the thing typed most often of all, a login and a password.",
      "The same years go into other ways for people to reach information by themselves. That work becomes DIP, the heart of a thesis defended in 2013.",
    ],
  },
  {
    date: "2008 – 2009",
    title: "Two fields meet",
    text: [
      "He meets Fanny Georges, a researcher from the social sciences with an idea about how a person is represented online: a semiotic model of digital identity.",
      "They work together on what the social networks of the time, Facebook and MySpace among them, laid open in astronomical quantities: people's profiles. The model reads them in three layers.",
    ],
  },
];

const idea: Entry[] = [
  {
    date: "2009 – 2010",
    title: "A sign-in built for the person",
    text: [
      "Out of that work comes an idea: a sign-in server designed around the human being, not around the machine, and not around what already exists.",
      "One finding follows quickly. The technologies and the standards needed to change how people sign in, and how systems manage them, are not there. The idea is put on hold.",
    ],
  },
];

const wait: Entry[] = [
  {
    date: "2011",
    title: "Circles",
    text: [
      "Google+ launches with circles: one account, and several audiences to choose between. A large platform admits that nobody shows the same face to everyone.",
    ],
  },
  {
    date: "2014",
    title: "A universal chat, never started",
    text: [
      "A project for one chat across many services meets the same gap: it needs something that gathers a person's services by identity. Nothing does, and the project does not start.",
    ],
  },
  {
    date: "2022",
    title: "Passkeys",
    text: [
      "The main browsers and operating systems begin to offer passkeys. Signing in with a gesture, instead of a secret to remember, becomes something anyone can use.",
    ],
  },
  {
    date: "2024",
    title: "Project Lévrier, and a name",
    text: [
      "While designing an ecosystem of tools, Project Lévrier, the same brick is missing once more: a way to manage users through their identities. This time it gets a name, brig·id.",
      "The same year, the first post-quantum standards are published. An identity system started now can rest on cryptography meant to outlast it.",
    ],
  },
];

const built: (Entry & { datetime: string })[] = [
  {
    date: "24 May 2026",
    datetime: "2026-05-24",
    title: "The project resumes",
    text: [
      "First commit. The cryptography library, the core, the server and the specifications are started on the same day. The specifications come first on purpose: the system is meant to be audited.",
    ],
  },
  {
    date: "29 July 2026",
    datetime: "2026-07-29",
    title: "A face",
    text: [
      "The web app begins: sign-up, sign-in and passkey management in a browser.",
    ],
  },
  {
    date: "4 September 2026",
    datetime: "2026-09-04",
    title: "leaf 0.1.0",
    text: [
      "First release of the smallest edition, then called leaf, as a container image. In the same days the project's own server, helm.brig.id, goes online.",
    ],
  },
  {
    date: "10 November 2026",
    datetime: "2026-11-10",
    title: "Accounts and identities part ways",
    text: [
      "The decision that gives brig·id its shape: an account is private and never shown to a website; an identity is what a website meets. Until then, one record played both roles.",
    ],
  },
  {
    date: "11 November 2026",
    datetime: "2026-11-11",
    title: "leaf 0.2",
    text: [
      "Identities reach a release. The same day settles how sessions work, how a website will obtain an identity, and what its identifier is made of.",
    ],
  },
];

const next = [
  "A recovery code, for the day every passkey is lost",
  "Sign-up in one gesture, with no username to invent",
  "Sign-in to websites with the identity you choose",
];
---

<Base
  title="History"
  description="brig·id started as a question in a research lab in 2008: can signing in be built around the person? Why it waited eighteen years, and where its name comes from."
>
  <section class="page-hero">
    <div class="shell-narrow">
      <p class="eyebrow">History</p>
      <h1>
        A question that waited{" "}
        <span class="accent spectrum nowrap">eighteen years.</span>
      </h1>
      <p class="lead">
        brig·id is young, and its question is not. It was asked in a research
        lab in 2008, and it had to wait for the technology to exist.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="shell-narrow chapter">
      <p class="year rise">2008 – 2010</p>
      <div class="prose rise">
        <h2>The question</h2>
      </div>

      <ol class="timeline">
        {question.map((entry) => (
          <li class="rise">
            <p class="when">{entry.date}</p>
            <h3>{entry.title}</h3>
            {entry.text.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </li>
        ))}
        <li class="rise">
          <p class="when">The model</p>
          <ul class="layers">
            <li>
              <b>Declarative</b>
              <span>
                what the person enters: a name, a photograph, a description.
              </span>
            </li>
            <li>
              <b>Acting</b>
              <span>what the platform reports the person doing.</span>
            </li>
            <li>
              <b>Calculated</b>
              <span>
                what the platform computes from that, and displays: counts,
                totals.
              </span>
            </li>
          </ul>
          <p>
            Only the first layer is written by the person. The other two are
            written by the platform, and they are the ones that grow.
          </p>
        </li>
        <li class="rise">
          <p class="when">2009</p>
          <h3>The paper</h3>
          <p>
            The work is presented at the H2PTM conference, by eight authors from
            both fields.
          </p>
          <figure class="cite card hue-self">
            <blockquote lang="fr">
              Sémiotique et visualisation de l’identité numérique&nbsp;: une
              étude comparée de Facebook et Myspace
            </blockquote>
            <figcaption>
              {authors}. <cite>H2PTM 2009</cite>.
            </figcaption>
            <a class="link-arrow" href={PAPER}>
              Read it on HAL
              <Icon name="arrow-up-right" />
            </a>
          </figure>
        </li>
        {idea.map((entry) => (
          <li class="rise">
            <p class="when">{entry.date}</p>
            <h3>{entry.title}</h3>
            {entry.text.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </li>
        ))}
      </ol>

      <p class="note rise">
        <Icon name="quotes-duotone" />
        <span>
          <strong>Whose idea.</strong> The sign-in server is Bérenger Arnaud's
          idea, and his alone. Fanny Georges and the other authors of the paper
          took no part in it and have no link with brig·id. It follows from
          their work, which is why it is told here.
          <a href="https://berenger.arnaud.work/research">
            More about that research.
          </a>
        </span>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="shell-narrow chapter">
      <p class="year rise">2011 – 2024</p>
      <div class="prose rise">
        <h2>The wait</h2>
        <p>
          For fourteen years the idea stays where it was left, and keeps being
          needed.
        </p>
      </div>

      <ol class="timeline">
        {wait.map((entry) => (
          <li class="rise">
            <p class="when">{entry.date}</p>
            <h3>{entry.title}</h3>
            {entry.text.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="shell-narrow chapter">
      <p class="year rise">2026</p>
      <div class="prose rise">
        <h2>Building it</h2>
      </div>

      <ol class="timeline">
        {built.map((entry) => (
          <li class="rise">
            <time class="when" datetime={entry.datetime}>
              {entry.date}
            </time>
            <h3>{entry.title}</h3>
            {entry.text.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </li>
        ))}
        <li class="rise upcoming">
          <StatusTag status="progress" />
          <h3>Next</h3>
          <ul>
            {next.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <a class="link-arrow" href="/features/">
            The status of everything
            <Icon name="arrow-right" />
          </a>
        </li>
      </ol>
    </div>
  </section>

  <section class="section" id="name">
    <div class="shell-narrow chapter">
      <p class="year rise">The name</p>
      <div class="prose rise">
        <h2>Why “brig·id”</h2>
        <p>
          The name had to hold two ideas at once: <strong>providing</strong> an
          identity, and <strong>isolating</strong> it.
        </p>
        <ul>
          <li>
            <strong>id.</strong> It is short, and it ends in <em>id</em> on
            purpose: this is an identity server.
          </li>
          <li>
            <strong>A brig is a ship.</strong> A two-masted one: the vessel that
            carries your identity where you need it.
          </li>
          <li>
            <strong>A brig is also a prison,</strong> the one aboard a ship:
            your identities are kept apart from each other.
          </li>
          <li>
            <strong>brig, bring.</strong> Said with a French accent, the two are
            close. It brings your identity to the websites you choose.
          </li>
          <li>
            <strong>Brigid</strong> is a goddess of Celtic Ireland, a country
            its author loves.
          </li>
        </ul>
        <p>
          The parts are named after a tree. <code>roots</code> is the workspace
          everything grows from; <code>seedling</code> is the smallest edition
          (it was first called <code>leaf</code>), <code>grove</code> the one
          for a community and <code>forest</code> the one for a company. The
          first server is called <code>helm</code>.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .chapter {
    display: grid;
    gap: 1.75rem;
  }

  .year {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(3.4rem, 11vw, 6.5rem);
    line-height: 0.9;
    letter-spacing: -0.02em;
    background: linear-gradient(180deg, var(--self), rgb(255 243 223 / 0.15));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .layers {
    border-top: 1px solid var(--line);
  }

  .layers li {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--text-2);
  }

  .layers b {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    line-height: 2.1;
    text-transform: uppercase;
    color: var(--text);
  }

  .cite {
    display: grid;
    gap: 1.1rem;
    margin: 0.5rem 0;
    padding: clamp(1.5rem, 4vw, 2.4rem);
    background:
      radial-gradient(
        30rem 16rem at 100% 0%,
        rgb(255 243 223 / 0.08),
        transparent 70%
      ),
      var(--bg-1);
  }

  .cite blockquote {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.5rem, 3.4vw, 2.2rem);
    line-height: 1.2;
    color: var(--self);
  }

  .cite figcaption {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--text-2);
  }

  .cite cite {
    font-style: normal;
    color: var(--text);
  }

  .timeline {
    display: grid;
    gap: 0;
    margin-left: 0.35rem;
    border-left: 1px solid var(--line-2);
  }

  .timeline > li {
    position: relative;
    display: grid;
    justify-items: start;
    gap: 0.5rem;
    padding: 0 0 2.5rem 2rem;
  }

  .timeline > li::before {
    content: "";
    position: absolute;
    left: -0.36rem;
    top: 0.45rem;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--self);
    box-shadow:
      0 0 0 0.3rem var(--bg),
      0 0 1rem var(--amber);
  }

  .timeline > li.upcoming::before {
    background: var(--bg);
    box-shadow:
      0 0 0 1px var(--amber) inset,
      0 0 0 0.3rem var(--bg);
  }

  .timeline .when {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .timeline h3 {
    font-size: 1.4rem;
    letter-spacing: -0.02em;
  }

  .timeline p:not(.when) {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--text-2);
  }

  .timeline .layers,
  .timeline .cite {
    width: 100%;
  }

  .timeline .link-arrow {
    font-size: 0.9rem;
    color: var(--text-2);
  }

  .upcoming ul {
    display: grid;
    gap: 0.4rem;
    padding-left: 1.1rem;
    list-style: disc;
    font-size: 1.05rem;
    color: var(--text-2);
  }

  @media (max-width: 36rem) {
    .layers li {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
