{
  "name": "@brig-id/site",
  "description": "brig·id — public website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build && node scripts/check-dist.mjs",
    "build.server": "pnpm run build",
    "preview": "wrangler dev --ip 0.0.0.0",
    "deploy": "wrangler deploy",
    "typecheck": "astro check && tsc --noEmit -p worker",
    "lint": "oxlint src worker scripts",
    "test": "vitest run",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check ."
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/sitemap": "^3.7.4",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@iconify-json/ph": "^1.2.2",
    "astro": "^7.4.10",
    "dotted-map": "^3.1.0",
    "oxlint": "^1.93.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  }
}
