{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  // worker/ runs on Cloudflare, not in a browser: it has its own tsconfig.
  "include": [".astro/types.d.ts", "src", "scripts", "*.config.*"],
  "exclude": ["dist", "node_modules", "worker"]
}
